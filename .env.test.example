# Test credentials - DO NOT COMMIT real values
# Copy to .env.test and fill in real values

# Password for private dashboard
TEST_PASSWORD=your_password_here

# Netlify Blobs configuration (optional - only if you want tests to use production blobs)
# NETLIFY_BLOBS_SITE_ID=your_site_id_here
# NETLIFY_BLOBS_TOKEN=your_token_here

# URLs (can override defaults in playwright.config.ts)
# LOCAL_URL=http://localhost:8888
# NETLIFY_URL=https://develop--dashboard0x.netlify.app
